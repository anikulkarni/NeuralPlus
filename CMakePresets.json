{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Developer build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "NEURALPLUS_BUILD_DOCS": "OFF",
        "NEURALPLUS_BUILD_EXAMPLES": "ON",
        "NEURALPLUS_BUILD_TESTS": "ON",
        "NEURALPLUS_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "NEURALPLUS_BUILD_DOCS": "OFF",
        "NEURALPLUS_BUILD_EXAMPLES": "ON",
        "NEURALPLUS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "docs",
      "displayName": "API documentation",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/docs",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "NEURALPLUS_BUILD_DOCS": "ON",
        "NEURALPLUS_BUILD_EXAMPLES": "OFF",
        "NEURALPLUS_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "docs",
      "configurePreset": "docs",
      "targets": [
        "neuralplus_docs"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
